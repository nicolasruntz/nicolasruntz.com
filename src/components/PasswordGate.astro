---
// Client-side only "gate": this is not security, just a keyword redirect.
// Anyone can read the check in the shipped JS. Treat it as a doorbell.
const REDIRECT_PATH = '/ap-automation-software/';
const PASSPHRASE = 'lazarus';
---

<form id="gate" class="gate" novalidate>
  <div class="gate__field">
    <svg class="gate__lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="5" y="10.5" width="14" height="10.5" rx="2.5"></rect>
      <path d="M8.25 10.5V7.25a3.75 3.75 0 0 1 7.5 0v3.25"></path>
    </svg>

    <input
      id="gate-input"
      name="password"
      type="password"
      autocomplete="current-password"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      placeholder=" "
      aria-label="Passphrase"
    />
    <label class="gate__label" for="gate-input">Passphrase</label>

    <button class="gate__go" type="submit" aria-label="Enter">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
        <path d="M5 12h13"></path>
        <path d="M12.5 6.5 19 12l-6.5 5.5"></path>
      </svg>
    </button>
  </div>
</form>

<script is:inline define:vars={{ REDIRECT_PATH, PASSPHRASE }}>
  const form = document.getElementById('gate');
  const input = document.getElementById('gate-input');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(input instanceof HTMLInputElement)) return;

    if (input.value.trim().toLowerCase() === PASSPHRASE) {
      window.location.href = REDIRECT_PATH;
      return;
    }

    // A wrong passphrase says nothing: no message, no colour change, no
    // shake. The field clears and waits.
    input.value = '';
    input.focus();
  });
</script>

<style>
  .gate {
    width: min(100%, 440px);
  }

  .gate__field {
    position: relative;

    display: flex;
    align-items: center;

    height: 64px;
    padding: 0 6px 0 20px;

    /* Frosted over the ribbon rather than an opaque card, so the background
       stays part of the composition. */
    background: rgba(254, 254, 254, 0.62);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);

    border: 1px solid rgba(20, 53, 78, 0.12);
    border-radius: 999px;
    box-shadow:
      0 1px 2px rgba(20, 53, 78, 0.04),
      0 18px 48px rgba(20, 53, 78, 0.1);

    transition:
      border-color 220ms cubic-bezier(0.2, 0.6, 0.2, 1),
      box-shadow 220ms cubic-bezier(0.2, 0.6, 0.2, 1),
      background 220ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .gate__field:focus-within {
    background: rgba(254, 254, 254, 0.8);
    border-color: rgba(20, 53, 78, 0.32);
    box-shadow:
      0 0 0 4px rgba(224, 24, 94, 0.16),
      0 22px 56px rgba(20, 53, 78, 0.14);
  }

  .gate__lock {
    width: 19px;
    height: 19px;
    flex: 0 0 auto;

    margin-right: 13px;

    color: #14354e;
    opacity: 0.42;

    transition: opacity 220ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .gate__field:focus-within .gate__lock {
    opacity: 0.7;
  }

  .gate__field input {
    flex: 1;
    min-width: 0;
    height: 100%;

    border: 0;
    outline: 0;
    background: transparent;

    /* 16px keeps iOS Safari from zooming the page on focus. */
    font: inherit;
    font-size: 16px;
    letter-spacing: 0.02em;
    color: #14354e;
  }

  /* The label rides up out of the field on focus or once something is typed.
     The placeholder is a single space so :placeholder-shown does the
     detection with no script. */
  .gate__label {
    position: absolute;
    left: 52px;
    top: 50%;
    transform: translateY(-50%);

    pointer-events: none;

    font-size: 16px;
    letter-spacing: 0.02em;
    color: rgba(20, 53, 78, 0.45);

    transition: all 220ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .gate__field input:focus + .gate__label,
  .gate__field input:not(:placeholder-shown) + .gate__label {
    top: 12px;
    transform: none;

    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(20, 53, 78, 0.5);
  }

  .gate__field input:focus,
  .gate__field input:not(:placeholder-shown) {
    padding-top: 16px;
  }

  .gate__go {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 52px;
    height: 52px;

    border: 0;
    border-radius: 50%;
    background: #14354e;
    color: #fefefe;
    cursor: pointer;

    transition:
      background 220ms cubic-bezier(0.2, 0.6, 0.2, 1),
      transform 220ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .gate__go svg {
    width: 20px;
    height: 20px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gate__go:hover {
    background: #e0185e;
    transform: translateX(2px);
  }

  .gate__go:active {
    transform: translateX(3px) scale(0.96);
  }

  .gate__go:focus-visible {
    outline: 2px solid #14354e;
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .gate__field {
      height: 58px;
      padding-left: 17px;
    }

    .gate__lock {
      margin-right: 11px;
    }

    .gate__label {
      left: 47px;
    }

    .gate__go {
      width: 47px;
      height: 47px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gate__field,
    .gate__lock,
    .gate__label,
    .gate__go {
      transition-duration: 0ms;
    }
  }
</style>
