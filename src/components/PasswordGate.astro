---
// Client-side only "gate": this is not real security, just a simple
// keyword redirect. Anyone can read the check in the shipped JS bundle.
const REDIRECT_PATH = '/ap-automation-software/';
---

<form id="password-gate" class="flex flex-col items-center gap-3" novalidate>
  <label for="password-gate-input" class="text-sm font-medium text-slate-700">
    Password
  </label>
  <div class="flex w-full max-w-xs gap-2">
    <input
      id="password-gate-input"
      name="password"
      type="password"
      autocomplete="off"
      class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
    />
    <button
      type="submit"
      class="shrink-0 rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-700"
    >
      Enter
    </button>
  </div>
  <p id="password-gate-error" class="h-4 text-xs text-red-600" role="alert" hidden>
    Incorrect password.
  </p>
</form>

<script is:inline define:vars={{ REDIRECT_PATH }}>
  const form = document.getElementById('password-gate');
  const input = document.getElementById('password-gate-input');
  const error = document.getElementById('password-gate-error');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (input instanceof HTMLInputElement && input.value === 'docking') {
      window.location.href = REDIRECT_PATH;
      return;
    }

    error?.removeAttribute('hidden');
  });

  input?.addEventListener('input', () => {
    error?.setAttribute('hidden', '');
  });
</script>
