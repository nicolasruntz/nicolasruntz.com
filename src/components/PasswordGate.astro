---
// Client-side only "gate": this is not real security, just a simple
// keyword redirect. Anyone can read the check in the shipped JS bundle.
const REDIRECT_PATH = '/ap-automation-software/';
---

<main class="page">
  <!-- Formulaire -->
  <form id="password-gate" class="login" novalidate>
    <label class="password" for="password-gate-input">
      <svg class="lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="5" y="10" width="14" height="11" rx="2"></rect>
        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
      </svg>

      <input
        id="password-gate-input"
        name="password"
        type="password"
        placeholder="Mot de passe"
        autocomplete="current-password"
      />
    </label>

    <button class="submit" type="submit" aria-label="Continuer">
      <span>&rarr;</span>
    </button>
  </form>

  <p id="password-gate-error" class="error" role="alert" hidden>Mot de passe incorrect.</p>
</main>

<script is:inline define:vars={{ REDIRECT_PATH }}>
  const form = document.getElementById('password-gate');
  const input = document.getElementById('password-gate-input');
  const error = document.getElementById('password-gate-error');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (input instanceof HTMLInputElement && input.value === 'odysseus') {
      window.location.href = REDIRECT_PATH;
      return;
    }

    error?.removeAttribute('hidden');
  });

  input?.addEventListener('input', () => {
    error?.setAttribute('hidden', '');
  });
</script>

<style>
  .page {
    width: min(100%, 620px);

    padding: 40px 24px;

    display: flex;
    flex-direction: column;
    align-items: center;

    position: relative;
    z-index: 1;
  }

  /* ==============================
     FORMULAIRE
  ============================== */

  .login {
    width: 100%;

    display: flex;
    align-items: center;

    gap: 12px;
  }

  /* Champ mot de passe */

  .password {
    flex: 1;

    height: 62px;

    display: flex;
    align-items: center;

    padding: 0 20px;

    background: rgba(255, 255, 255, 0.8);

    border: 1px solid #d8d8dc;

    border-radius: 14px;

    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.025);

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .password:focus-within {
    border-color: #999;

    box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.035);
  }

  /* Icône cadenas */

  .lock {
    width: 20px;
    height: 20px;

    margin-right: 15px;

    color: #555;

    opacity: 0.5;

    flex-shrink: 0;
  }

  /* Input */

  .password input {
    width: 100%;

    border: 0;
    outline: 0;

    background: transparent;

    font-size: 17px;

    color: #222;
  }

  .password input::placeholder {
    color: #a5a5aa;
  }

  /* ==============================
     BOUTON
  ============================== */

  .submit {
    width: 62px;
    height: 62px;

    flex-shrink: 0;

    border: 0;

    border-radius: 14px;

    background: #171717;

    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .submit:hover {
    transform: translateX(3px);

    background: #000;
  }

  .submit:active {
    transform: translateX(5px) scale(0.96);
  }

  /* Flèche */

  .submit span {
    font-size: 25px;

    font-weight: 300;

    line-height: 1;
  }

  /* Message d'erreur */

  .error {
    margin-top: 14px;

    font-size: 13px;

    color: #c0392b;
  }

  /* ==============================
     RESPONSIVE
  ============================== */

  @media (max-width: 600px) {
    .page {
      padding: 25px 18px;
    }

    .login {
      gap: 8px;
    }

    .password {
      height: 58px;

      border-radius: 12px;
    }

    .submit {
      width: 58px;
      height: 58px;

      border-radius: 12px;
    }
  }
</style>
