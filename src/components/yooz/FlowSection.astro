---
import Icon from './Icon.astro';

const flow = [
  [
    'shopping_cart',
    'Purchase',
    'Create PR/PO/GR and approve using workflows. Automate PO import from financial systems.',
  ],
  [
    'document_scanner',
    'Capture',
    'Automate multi-channel capture: email, drag & drop, mobile, scan, sFTP, e-invoicing, fetcher, API.',
  ],
  [
    'fact_check',
    'Review',
    'Automate GL coding and PO matching. Automate vendor statement reconciliation.',
  ],
  [
    'task_alt',
    'Approve',
    'Approve or reject using smart workflows (parallel & line level capabilities).',
  ],
  [
    'payments',
    'Pay',
    'Automate payment: Virtual Card, ACH, eCheck, Paper Check in NORAM, SEPA transfers in EU.',
  ],
  ['ios_share', 'Export', 'Automate export to more than 250 financial systems.'],
];

const tags = ['Archive', 'Search', 'Monitor', 'Optimize', 'Audit', 'Reconcile', 'Secure'];
---

<section class="flow">
  <div class="inner">
    <div class="head">
      <h2>Achieve maximum automation of your AP automation solution</h2>
      <p>Straight Through Processing — Touchless Document — Scalable</p>
    </div>

    <div class="grid">
      {
        flow.map(([icon, title, body], i) => (
          <article class="card">
            <div class="card-top">
              <Icon name={icon} size={26} />
              <span class="step">0{i + 1}</span>
            </div>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))
      }
    </div>

    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</section>

<style>
  .flow {
    background: var(--yz-grey-10);
    color: var(--text);
    padding: var(--section-y) var(--gutter);
  }

  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  /* Layouts are generous and left-aligned; long-form content is never centred. */
  .head {
    max-width: var(--container-narrow);
  }

  h2 {
    margin: 0;

    font-size: var(--fs-h3);
    font-weight: var(--fw-light);
    letter-spacing: var(--ls-h3);
    line-height: var(--lh-h3);
  }

  .head p {
    margin: 18px 0 0;

    font-size: var(--fs-paragraph);
    letter-spacing: var(--ls-paragraph);
    line-height: var(--lh-body-web);
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;

    margin-top: 48px;
  }

  /* Cards: 16px radius, hairline Grey-40 stroke, flat fill, no shadow at
     rest — depth comes from the stroke, not from elevation. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;

    background: var(--yz-grey-10);
    border: 1px solid var(--yz-grey-40);
    border-radius: var(--radius-lg);
    padding: 20px;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step {
    font-size: var(--fs-ui-xs);
    font-weight: var(--fw-semibold);
    color: var(--yz-grey-70);
  }

  .card h3 {
    margin: 0;

    font-size: 20px;
    font-weight: var(--fw-light);
    letter-spacing: -0.02em;
  }

  .card p {
    margin: 0;

    font-size: var(--fs-ui);
    font-weight: var(--fw-light);
    letter-spacing: -0.02em;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;

    margin-top: 24px;
  }

  .tag {
    font-size: var(--fs-ui);
    letter-spacing: -0.02em;

    border: 1px solid var(--yz-grey-50);
    border-radius: var(--radius-pill);
    padding: 7px 14px;
  }

  @media (max-width: 1040px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .flow {
      padding-block: 64px;
    }

    h2 {
      font-size: 34px;
    }

    .grid {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }
  }
</style>
