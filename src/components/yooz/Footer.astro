---
import Wordmark from './Wordmark.astro';

const cols: [string, string[]][] = [
  ['Solutions', ['Purchase to Pay', 'Invoice capture', 'Approval workflows', 'Payments', 'E-invoicing']],
  ['Resources', ['Ebooks', 'Webinars', 'Whitepapers', 'Yooz Score', 'Help centre']],
  ['Company', ['About', 'Careers', 'Partners', 'Newsroom', 'Contact']],
];
---

<footer class="footer">
  <div class="inner">
    <div>
      <Wordmark mode="white" height={32} />
      <p class="tagline">Lean Financial Operations™, only with Yooz.</p>
    </div>

    {
      cols.map(([heading, links]) => (
        <nav aria-label={heading}>
          <div class="col-head">{heading}</div>
          <div class="col-links">
            {links.map((link) => (
              <a href="#">{link}</a>
            ))}
          </div>
        </nav>
      ))
    }
  </div>

  <div class="legal">
    <span>© 2026 Yooz. All rights reserved.</span>
    <span>getyooz.com</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--yz-rich-blue);
    color: var(--yz-grey-10);
    padding: 64px var(--gutter) 40px;
  }

  .inner {
    max-width: var(--container-max);
    margin: 0 auto;

    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px;
  }

  .tagline {
    margin: 20px 0 0;
    max-width: 300px;

    font-size: var(--fs-paragraph-sm-bold);
    font-weight: var(--fw-light);
    letter-spacing: -0.02em;
    line-height: 1.5;
    color: rgba(254, 254, 254, 0.7);
  }

  .col-head {
    margin-bottom: 16px;

    font-size: var(--fs-ui-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(254, 254, 254, 0.45);
  }

  .col-links {
    display: grid;
    gap: 10px;
  }

  .col-links a {
    font-size: 15px;
    font-weight: var(--fw-light);
    letter-spacing: -0.02em;
    color: rgba(254, 254, 254, 0.82);
    text-decoration: none;

    transition: color var(--duration-fast) var(--ease-standard);
  }

  .col-links a:hover {
    color: var(--yz-grey-10);
  }

  .legal {
    max-width: var(--container-max);
    margin: 48px auto 0;
    padding-top: 24px;

    border-top: 1px solid rgba(254, 254, 254, 0.15);

    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;

    font-size: var(--fs-ui-sm);
    color: rgba(254, 254, 254, 0.55);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 480px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
