---
/**
 * Material Symbols Outlined, the brand's icon set (guidelines p.24).
 * Renders the ligature name; never paste inline SVG in its place.
 */
interface Props {
  name: string;
  size?: number;
  weight?: number;
  fill?: 0 | 1;
  color?: string;
}

const { name, size = 20, weight = 300, fill = 0, color = 'currentColor' } = Astro.props;

const style = [
  `font-size:${size}px`,
  `color:${color}`,
  `font-variation-settings:"FILL" ${fill},"wght" ${weight},"GRAD" 0,"opsz" ${size}`,
].join(';');
---

<span class="yz-icon" style={style} aria-hidden="true">{name}</span>
