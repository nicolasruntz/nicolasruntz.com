---
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';

const items = ['Solutions', 'Integrations', 'Resources', 'About', 'Help centre'];
---

<header class="nav">
  <div class="inner">
    <a class="brand" href="#top"><Wordmark height={30} /></a>

    <nav class="links" aria-label="Main">
      {items.map((item) => <a href="#">{item}</a>)}
    </nav>

    <div class="spacer"></div>

    <div class="actions">
      <a class="login" href="#">Login</a>
      <span class="region">UK</span>
      <Button size="sm" href="#">Create account</Button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;

    background: var(--yz-grey-10);
    border-bottom: 1px solid var(--yz-grey-30);
  }

  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 76px;

    display: flex;
    align-items: center;
    gap: 36px;
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 26px;
    margin-left: 12px;
  }

  .links a {
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;

    transition: color var(--duration-fast) var(--ease-standard);
  }

  .links a:hover {
    color: var(--yz-pink);
  }

  .spacer {
    flex: 1;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* Login is a Link in `tone="default"`, `underline="never"`. */
  .login {
    color: var(--yz-rich-blue);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .region {
    font-size: 14px;
    color: var(--text-muted);
  }

  /* The kit is authored at 1280px; below that the nav sheds its middle
     links rather than wrapping into a second row. */
  @media (max-width: 1040px) {
    .links {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .inner {
      gap: 16px;
      height: 68px;
    }

    .region {
      display: none;
    }
  }
</style>
