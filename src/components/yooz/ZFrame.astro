---
/**
 * The Z-shaped hero frame (guidelines p.31–32), anchored bottom-left.
 *
 * No vector was supplied for the Z, so the clip-path is the design
 * system's approximation. No photography was supplied either: the kit
 * renders a "cut-out hero photograph goes here" annotation in its place,
 * which is authoring scaffolding — on the live page the Z stands on its
 * own as a brand graphic. Pass `src` once a graded cut-out exists.
 */
interface Props {
  src?: string;
  alt?: string;
  anchor?: 'bottom-left' | 'top-right';
  height?: number;
}

const { src, alt = '', anchor = 'bottom-left', height = 360 } = Astro.props;
---

<div class="zframe" style={`height:${height}px`} aria-hidden={src ? undefined : 'true'}>
  <div class:list={['z', `is-${anchor}`]}></div>
  {src && <img src={src} alt={alt} class:list={[`is-${anchor}`]} />}
</div>

<style>
  .zframe {
    position: relative;
    overflow: hidden;
  }

  .z {
    position: absolute;
    width: 62%;
    height: 82%;

    background: var(--gradient-image-map);

    /* Z: top bar, diagonal, bottom bar. */
    clip-path: polygon(
      0% 0%,
      100% 0%,
      100% 24%,
      40% 76%,
      100% 76%,
      100% 100%,
      0% 100%,
      0% 76%,
      60% 24%,
      0% 24%
    );
  }

  .z.is-bottom-left {
    bottom: 0;
    left: 0;
  }

  .z.is-top-right {
    top: 0;
    right: 0;
  }

  img {
    position: relative;
    height: 100%;
    width: auto;
    object-fit: contain;
    display: block;

    /* Every image is graded the same way — B&W, then the pink /
       Rich Blue gradient map. Never natural-colour photography. */
    filter: grayscale(1) contrast(1.05);
  }

  img.is-bottom-left {
    margin: 0 auto 0 0;
  }

  img.is-top-right {
    margin: 0 0 0 auto;
  }

  @media (max-width: 1040px) {
    .zframe {
      height: 320px !important;
    }
  }

  @media (max-width: 640px) {
    .zframe {
      height: 220px !important;
    }
  }
</style>
