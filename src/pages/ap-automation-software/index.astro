---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

import '../../styles/yooz.css';
import '../../styles/ap-automation.css';

import ApLanding from '../../components/ap/ApLanding';

// Metadata still comes from the content collection; the page itself is the
// personalised landing page island below.
const entry = await getEntry('pages', 'ap-automation-software');
if (!entry) {
  throw new Error('Missing content entry: pages/ap-automation-software');
}

const { title, description, noindex } = entry.data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
    />
  </Fragment>

  <!-- client:load rather than client:idle: the pickers and the demo CTA are
       what this page exists for, and it is built for paid traffic. -->
  <ApLanding client:load />
</BaseLayout>

<style is:global>
  /* The design system owns this page end to end: Noto Sans throughout, Rich
     Blue on the brand white (never pure #FFFFFF). */
  .ap-root {
    font-family: var(--font-sans);
    color: var(--text);
    background: var(--background);
    -webkit-font-smoothing: antialiased;
  }

  .ap-root ::selection {
    background: var(--yz-pink);
    color: var(--yz-grey-10);
  }

  /* Focus: the one sanctioned place pink exceeds its 10% budget. */
  .ap-root input:focus-visible,
  .ap-root select:focus-visible,
  .ap-root button:focus-visible,
  .ap-modal input:focus-visible,
  .ap-modal select:focus-visible,
  .ap-modal button:focus-visible {
    outline: none;
    border-color: var(--yz-rich-blue);
    box-shadow: 0 0 0 3px rgba(224, 24, 94, 0.28);
  }

  /* Prose links only. Anchors styled as buttons carry their own colours, and
     this rule outranks them on specificity — which painted "Get my pricing"
     pink on a pink pill. */
  .ap-root a:not(.ap-btn-pink) {
    color: var(--yz-pink);
    text-decoration: none;
  }

  .ap-root a:not(.ap-btn-pink):hover {
    color: var(--yz-pink-hover);
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
