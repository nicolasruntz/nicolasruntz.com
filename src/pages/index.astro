---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordGate from '../components/PasswordGate.astro';
import RibbonBackground from '../components/home/RibbonBackground';

// The Yooz tokens are the single source of truth for the ribbon's palette:
// the shader reads its colours back off these custom properties at runtime.
import '../styles/yooz.css';

const title = 'Nicolas Runtz';
const description = "Nicolas Runtz's personal website.";

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolas Runtz',
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;600&display=swap"
    />
  </Fragment>

  <div class="hp">
    <!-- Decorative, and deferred: the line and the field render and work
         before any of this loads. -->
    <RibbonBackground client:idle />

    <main class="hp__content">
      <p class="hp__line">Do not go gentle into that good night</p>
      <PasswordGate />
    </main>
  </div>
</BaseLayout>

<style is:global>
  .hp {
    position: relative;
    min-height: 100svh;

    display: grid;
    grid-template-rows: 40svh 1fr;
    justify-items: center;

    padding: 0 24px 40px;

    font-family: var(--font-sans);
    color: var(--yz-rich-blue);
    background: var(--yz-grey-10);
    -webkit-font-smoothing: antialiased;
  }

  .hp ::selection {
    background: var(--yz-pink);
    color: var(--yz-grey-10);
  }

  /* ── background stack ────────────────────────────────────────────────
     Fixed and out of flow, so nothing here can shift the layout. */

  .hp-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Painted immediately: no flash before the canvas is ready, and the whole
     background if WebGL never arrives. Same palette, same diagonal. */
  .hp-bg__static {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        118deg,
        transparent 22%,
        rgba(20, 53, 78, 0.9) 34%,
        rgba(20, 53, 78, 0.72) 44%,
        transparent 56%
      ),
      linear-gradient(115deg, transparent 28%, rgba(224, 24, 94, 0.62) 39%, transparent 49%),
      linear-gradient(180deg, var(--yz-grey-20), var(--yz-grey-10));
  }

  .hp-bg__canvas,
  .hp-bg__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The canvas arrives over plain off-white once it has a frame to show. */
  .hp-bg__canvas {
    opacity: 0;
    transition: opacity 700ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .hp-bg[data-ready] .hp-bg__canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-bg__canvas {
      transition: none;
    }
  }

  .hp-bg__fallback {
    object-fit: cover;
    object-position: 50% 0%;
  }

  .hp-bg__static,
  .hp-bg__canvas,
  .hp-bg__fallback {
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 50%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 50%);
  }

  /* The brand dot pattern, kept far enough back to read as texture rather
     than noise. */
  .hp-bg__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(20, 53, 78, 0.16) 1px, transparent 0);
    background-size: 6px 6px;
    opacity: 0.34;
  }

  /* ── content ─────────────────────────────────────────────────────── */

  .hp__content {
    position: relative;
    z-index: 1;
    grid-row: 2;
    align-self: center;

    width: min(100%, 640px);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .hp__line {
    margin: 0;

    /* Light at negative tracking is the brand's voice; a bold heading here
       would break it. */
    font-size: clamp(28px, 4.6vw, 52px);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.14;
    text-align: center;
    text-wrap: balance;
    color: var(--yz-rich-blue);
  }

  @media (max-width: 600px) {
    .hp__content {
      gap: 32px;
    }
  }
</style>
