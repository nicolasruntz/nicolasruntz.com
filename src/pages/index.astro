---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordGate from '../components/PasswordGate.astro';

const title = 'Nicolas Runtz';
const description = "Nicolas Runtz's personal website.";

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolas Runtz',
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </Fragment>

  <div class="gate-backdrop">
    <PasswordGate />
  </div>
</BaseLayout>

<style>
  .gate-backdrop {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    position: relative;

    background:
      radial-gradient(circle at 20% 20%, rgba(225, 218, 255, 0.45), transparent 28%),
      radial-gradient(circle at 85% 80%, rgba(235, 230, 255, 0.55), transparent 30%),
      #fafafa;
    background-size:
      180% 180%,
      180% 180%,
      auto;
  }

  /* Cercle décoratif en haut à gauche */
  .gate-backdrop::before {
    content: '';

    position: fixed;

    width: 420px;
    height: 420px;

    border: 1px solid rgba(120, 110, 180, 0.1);
    border-radius: 50%;

    top: -230px;
    left: -130px;
  }

  /* Cercle décoratif en bas à droite */
  .gate-backdrop::after {
    content: '';

    position: fixed;

    width: 500px;
    height: 500px;

    border: 1px solid rgba(120, 110, 180, 0.08);
    border-radius: 50%;

    bottom: -300px;
    right: -180px;
  }

  /* Petit effet dynamique : dégradés qui dérivent doucement,
     cercles qui pulsent très légèrement. Désactivé si l'utilisateur
     préfère un mouvement réduit. */
  @media (prefers-reduced-motion: no-preference) {
    .gate-backdrop {
      animation: drift 26s ease-in-out infinite;
    }

    .gate-backdrop::before {
      animation: pulse 14s ease-in-out infinite;
    }

    .gate-backdrop::after {
      animation: pulse 18s ease-in-out infinite reverse;
    }
  }

  @keyframes drift {
    0%,
    100% {
      background-position:
        20% 20%,
        85% 80%,
        0 0;
    }
    50% {
      background-position:
        30% 30%,
        75% 70%,
        0 0;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.06);
      opacity: 0.6;
    }
  }
</style>
